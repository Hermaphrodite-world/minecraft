<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:HermaLauncher.ViewModels"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="360"
        x:Class="HermaLauncher.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="520" Height="486"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Title="Herma Launcher">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Border Padding="28">
        <Grid RowDefinitions="Auto,*,Auto,Auto,Auto,Auto">

            <StackPanel Grid.Row="0" Spacing="2">
                <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="{Binding ServerLabel}" Opacity="0.6" FontSize="13" />
            </StackPanel>

            <Border Grid.Row="1" VerticalAlignment="Center">
                <SelectableTextBlock Text="{Binding StatusMessage}"
                                     TextWrapping="Wrap"
                                     FontSize="14"
                                     Foreground="#D0D0D0" />
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" Margin="0,0,0,12">
                <TextBlock Text="닉네임" VerticalAlignment="Center" Opacity="0.7" />
                <TextBox Text="{Binding Username}" Width="160" Watermark="Player" />
                <CheckBox Content="오프라인 모드(친구 서버)" IsChecked="{Binding IsOffline}" VerticalAlignment="Center" />
            </StackPanel>

            <ProgressBar Grid.Row="3" Margin="0,0,0,16"
                         Minimum="0" Maximum="100"
                         Value="{Binding Progress}"
                         IsIndeterminate="{Binding IsIndeterminate}" />

            <Grid Grid.Row="4" ColumnDefinitions="*,Auto">
                <Button Grid.Column="0"
                        Content="Play"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        FontSize="16" FontWeight="SemiBold"
                        Padding="0,12"
                        Command="{Binding PlayCommand}" />
                <Button Grid.Column="1"
                        Content="취소"
                        Margin="12,0,0,0"
                        Padding="16,12"
                        Command="{Binding CancelCommand}" />
            </Grid>

            <StackPanel Grid.Row="5" Spacing="5" Margin="0,14,0,0">
                <Button Content="공식 마인크래프트 런처에 설치  (정품 로그인 · 승인 대기 없이)"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Padding="0,9"
                        Command="{Binding InstallToOfficialCommand}" />
                <TextBlock Text="공식 런처를 닫은 뒤 눌러주세요. 끝나면 공식 런처에서 'Hermaphrodite World' 프로필을 선택해 플레이합니다."
                           FontSize="11" Opacity="0.55"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
