<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:HermaLauncher.ViewModels"
        mc:Ignorable="d" d:DesignWidth="940" d:DesignHeight="640"
        x:Class="HermaLauncher.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="940" Height="486"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}"
        Icon="/Assets/app.png"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Title="Herma Launcher">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ── Title bar (드래그 영역 + 로고 + 창 컨트롤) ── -->
        <Grid Grid.Row="0" x:Name="TitleBar" Height="50" Background="Transparent"
              ColumnDefinitions="Auto,*,Auto">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                        Margin="16,0,0,0" VerticalAlignment="Center">
                <!-- 히어로와 같은 씬으로 채워 둥글게 클립 → 투명 모서리(어두운 배경 비침) 없이 앱 아이콘 통일. -->
                <Border Width="30" Height="30" CornerRadius="8" ClipToBounds="True" VerticalAlignment="Center">
                    <Image Source="/Assets/hero.png" Stretch="UniformToFill" />
                </Border>
                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold"
                           VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"
                        Margin="0,0,12,0" VerticalAlignment="Center">
                <Button Classes="chrome" x:Name="MinBtn" Content="—" />
                <Button Classes="chrome close" x:Name="CloseBtn" Content="✕" />
            </StackPanel>
        </Grid>

        <!-- ── Content ── -->
        <Panel Grid.Row="1">

            <!-- Main: 두 카드 + 히어로 + 칩 + 진행 -->
            <Grid IsVisible="{Binding IsMain}" Margin="24,4,24,18" VerticalAlignment="Center"
                  ColumnDefinitions="*,300" RowDefinitions="Auto,Auto,Auto,Auto">

                <!-- 헤더 텍스트 (좌) -->
                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="3" Margin="2,0,0,14">
                    <TextBlock Text="어떻게 플레이할까요?" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="12.5"
                               Foreground="{StaticResource TextMuted}" />
                </StackPanel>

                <!-- 히어로 아트 (우, 헤더+카드 높이에 맞춤). ImageBrush 배경으로 깔아 이미지가
                     Auto 행 높이를 부풀리지 않게 한다 → 헤더-카드 사이 빈 공백 제거. -->
                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" CornerRadius="18"
                        Margin="22,0,0,0" ClipToBounds="True"
                        BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                    <Border.Background>
                        <ImageBrush Source="/Assets/hero.png" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>

                <!-- 두 카드 (좌) -->
                <Grid Grid.Row="1" Grid.Column="0" ColumnDefinitions="*,*">

                    <!-- 바로 플레이 (이 런처로 직접 실행) -->
                    <Border Grid.Column="0" Background="{StaticResource CardBg}"
                            BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                            CornerRadius="16" Padding="18" Margin="0,0,7,0">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="11">
                                <Border Width="40" Height="40" CornerRadius="11"
                                        Background="{StaticResource AccentBrush}">
                                    <TextBlock Text="▶" FontSize="16" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="바로 플레이" FontSize="14" FontWeight="Bold" />
                                    <TextBlock Text="클릭 한 번으로 서버 접속" FontSize="11"
                                               Foreground="{StaticResource TextMuted}" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Margin="0,16,0,0" VerticalAlignment="Top"
                                       Text="마이크로소프트 정품 계정으로 로그인하고, 모드팩을 동기화한 뒤 서버에 자동 접속합니다."
                                       FontSize="12" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />

                            <Button Grid.Row="2" Classes="play" Content="▶  PLAY"
                                    Margin="0,16,0,0" Command="{Binding PlayCommand}" />
                        </Grid>
                    </Border>

                    <!-- 공식 런처에 설치 -->
                    <Border Grid.Column="1" Background="{StaticResource CardBg}"
                            BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                            CornerRadius="16" Padding="18" Margin="7,0,0,0">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="11">
                                <Border Width="40" Height="40" CornerRadius="11" Background="#1E3A4D">
                                    <TextBlock Text="↓" FontSize="18" Foreground="{StaticResource AccentCyan}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="공식 런처에 설치" FontSize="14" FontWeight="Bold" />
                                    <TextBlock Text="정품 계정으로 공식 런처에서" FontSize="11"
                                               Foreground="{StaticResource TextMuted}" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Margin="0,16,0,0" VerticalAlignment="Top"
                                       Text="'Hermaphrodite World' 프로필을 공식 마인크래프트 런처에 추가합니다. 설치 전 공식 런처를 완전히 닫아주세요."
                                       FontSize="12" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />

                            <Button Grid.Row="2" Classes="play" Content="공식 런처에 설치"
                                    Margin="0,16,0,0" Command="{Binding InstallToOfficialCommand}" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- 상태 칩 (전체 폭) -->
                <WrapPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,16,0,0">
                    <Border Classes="chip" Margin="0,0,8,8">
                        <TextBlock Text="{Binding VersionChip}" />
                    </Border>
                    <Border Classes="chip" Margin="0,0,8,8">
                        <TextBlock Text="Fabric" />
                    </Border>
                    <Border Classes="chip" Margin="0,0,8,8">
                        <TextBlock Text="77 Mods" />
                    </Border>
                    <Border Classes="chip" Margin="0,0,8,8">
                        <TextBlock Text="✓ 자동 업데이트" />
                    </Border>
                </WrapPanel>

                <!-- 상태 + 진행 (전체 폭). 상세 로그는 푸터의 '로그'로 통일. -->
                <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0"
                      RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                    <SelectableTextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding StatusMessage}"
                                         TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                         FontSize="13" Foreground="#D2D2DE" VerticalAlignment="Center" />
                    <ProgressBar Grid.Row="1" Grid.Column="0" Margin="0,8,0,0" Minimum="0" Maximum="100"
                                 Value="{Binding Progress}" IsIndeterminate="{Binding IsIndeterminate}" />
                    <Button Grid.Row="1" Grid.Column="1" Classes="ghost" Content="취소"
                            Margin="12,8,0,0" Padding="18,8"
                            IsVisible="{Binding IsBusy}" Command="{Binding CancelCommand}" />
                    <!-- 오류/크래시 시 진단 바로가기(P3-4). 폴더를 열어 launcher-*.log + game-*.log 를 함께
                         찾을 수 있게 함(Codex UX-R2 — 크래시는 게임 로그가 핵심). 작업 중 아닐 때만(취소와 자리 공유). -->
                    <Button Grid.Row="1" Grid.Column="1" Classes="ghost" Content="🗎  로그 열기"
                            Margin="12,8,0,0" Padding="18,8"
                            IsVisible="{Binding CanShowErrorLog}" Command="{Binding OpenLogFolderCommand}" />
                </Grid>
            </Grid>

            <!-- 공식 런처 설치 완료 (전용 화면) -->
            <StackPanel IsVisible="{Binding IsOfficialDone}" VerticalAlignment="Center"
                        HorizontalAlignment="Center" MaxWidth="460" Spacing="16" Margin="24">
                <Border Width="64" Height="64" CornerRadius="32"
                        Background="{StaticResource AccentBrush}" HorizontalAlignment="Center">
                    <TextBlock Text="✓" FontSize="34" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="설치 완료!" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
                <Border Background="{StaticResource PanelBg}" CornerRadius="12" Padding="18"
                        BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                    <StackPanel Spacing="9">
                        <TextBlock Text="이제 공식 런처에서 플레이하세요" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{StaticResource AccentCyan}" />
                        <TextBlock Text="1.  공식 마인크래프트 런처를 엽니다" FontSize="13" TextWrapping="Wrap" />
                        <TextBlock Text="2.  좌하단에서 'Hermaphrodite World' 프로필을 선택 후 플레이" FontSize="13" TextWrapping="Wrap" />
                        <TextBlock Text="3.  멀티플레이 목록에서 'Hermaphrodite World' 서버를 선택해 접속" FontSize="13" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding ServerLabel}" FontSize="12"
                           Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" />
                <Button Classes="ghost" Content="메뉴로 돌아가기" Padding="0,12"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Command="{Binding BackToMenuCommand}" />
            </StackPanel>

            <!-- 설정 / 복구 (P3-2: 계정 재설정 · RAM · 로그) -->
            <StackPanel IsVisible="{Binding IsSettings}" VerticalAlignment="Center"
                        HorizontalAlignment="Center" MaxWidth="480" Spacing="13" Margin="24,8">
                <TextBlock Text="설정" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />

                <!-- 계정 -->
                <Border Background="{StaticResource PanelBg}" CornerRadius="12" Padding="16"
                        BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="계정" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding AccountLabel}" FontSize="12.5"
                                   Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                        <Button Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Classes="ghost" Content="로그아웃"
                                Padding="16,8" VerticalAlignment="Center"
                                Command="{Binding LogoutCommand}" />
                    </Grid>
                </Border>

                <!-- 메모리(RAM) -->
                <Border Background="{StaticResource PanelBg}" CornerRadius="12" Padding="16"
                        BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                    <StackPanel Spacing="9">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="메모리 (RAM)" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Grid.Column="1" Text="{Binding RamSummary}" FontSize="12.5"
                                       Foreground="{StaticResource AccentCyan}" VerticalAlignment="Center" />
                        </Grid>
                        <CheckBox Content="자동 (호스트 메모리에 맞춰 권장값 사용)" IsChecked="{Binding RamAuto}" />
                        <Slider Minimum="{Binding RamMinMb}" Maximum="{Binding RamMaxMb}"
                                Value="{Binding MaxRamMb}" TickFrequency="512" IsSnapToTickEnabled="True"
                                IsEnabled="{Binding !RamAuto}" />
                    </StackPanel>
                </Border>

                <!-- 진단 -->
                <Button Classes="ghost" Content="🗎  로그 폴더 열기" Padding="0,11"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Command="{Binding OpenLogFolderCommand}" />

                <!-- 닫기 / 저장 -->
                <Grid ColumnDefinitions="*,*" Margin="0,2,0,0">
                    <Button Grid.Column="0" Classes="ghost" Content="닫기" Padding="0,12" Margin="0,0,6,0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Command="{Binding BackToMenuCommand}" />
                    <Button Grid.Column="1" Classes="play" Content="저장" Margin="6,0,0,0"
                            Command="{Binding SaveSettingsCommand}" />
                </Grid>
            </StackPanel>
        </Panel>

        <!-- ── Footer nav (스텁) ── -->
        <Border Grid.Row="2" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0"
                Padding="16,8">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2">
                    <!-- 외부 링크는 URL 이 설정된 것만 표시(P3-6 — 빈 URL no-op 버튼 숨김) -->
                    <Button Classes="foot" Content="💬  디스코드" Command="{Binding OpenDiscordCommand}"
                            IsVisible="{Binding HasDiscord}" />
                    <Button Classes="foot" Content="📖  가이드" Command="{Binding OpenGuideCommand}"
                            IsVisible="{Binding HasGuide}" />
                    <Button Classes="foot" Content="🌐  웹사이트" Command="{Binding OpenWebsiteCommand}"
                            IsVisible="{Binding HasWebsite}" />
                </StackPanel>
                <!-- 런처 버전(P3-1) -->
                <TextBlock Grid.Column="1" Text="{Binding LauncherVersionLabel}" FontSize="11"
                           Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"
                           HorizontalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                    <Button Classes="foot" Content="⚙  설정" Command="{Binding OpenSettingsCommand}" />
                    <Button Classes="foot" Content="🗎  로그" Command="{Binding OpenLogsCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
