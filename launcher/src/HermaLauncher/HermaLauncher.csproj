<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Windows exe 아이콘 (작업표시줄/탐색기). 창 아이콘은 MainWindow.axaml 의 Icon. macOS 는 app.icns. -->
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>HermaLauncher</RootNamespace>
    <AssemblyName>HermaLauncher</AssemblyName>
    <!-- PE 버전 메타데이터 (Authenticode 휴리스틱 신뢰 신호) -->
    <Company>Hermaphrodite-world</Company>
    <Product>Herma Launcher</Product>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Version>0.1.0</Version>
    <!-- NU1903: Tmds.DBus.Protocol 는 Avalonia 의 Linux 전용 transitive dep. 본 런처는
         Windows/macOS 타깃이라 DBus 경로 미사용 → 해당 advisory 비해당. -->
    <NoWarn>$(NoWarn);NU1903</NoWarn>
    <!-- 재현성(P2-5): SDK 는 global.json 으로 핀. 패키지 버전은 본 csproj 에 고정.
         packages.lock.json 은 Avalonia.Diagnostics 의 Debug-conditional 참조와 충돌(Debug locked restore NU1004,
         Release/Debug 비대칭)해 마찰이 가치보다 커서 미사용(Codex P2-5). -->
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <!-- 단위 테스트(P4)에서 internal 순수 로직(ParsePackArray 등) 접근 허용 -->
  <ItemGroup>
    <InternalsVisibleTo Include="HermaLauncher.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.0" />
    <!-- 디버그 빌드에서만 진단 도구 -->
    <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="Avalonia.Diagnostics" Version="11.3.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="CmlLib.Core" Version="4.0.6" />
    <PackageReference Include="CmlLib.Core.Installer.NeoForge" Version="4.0.0" />
    <PackageReference Include="CmlLib.Core.Auth.Microsoft" Version="3.3.1" />
    <PackageReference Include="Velopack" Version="1.2.0" />
    <PackageReference Include="XboxAuthNet.Game.Msal" Version="0.1.3" />
  </ItemGroup>

</Project>
