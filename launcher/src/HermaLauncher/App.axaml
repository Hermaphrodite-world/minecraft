<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HermaLauncher.App"
             xmlns:local="using:HermaLauncher"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <!-- 게이밍 톤 팔레트: 다크 + 보라/마젠타 네온 accent -->
        <LinearGradientBrush x:Key="WindowBg" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#0A0A12" Offset="0" />
            <GradientStop Color="#13131E" Offset="0.55" />
            <GradientStop Color="#1A1230" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AccentBrush" StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Color="#7C3AED" Offset="0" />
            <GradientStop Color="#EC4899" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AccentBrushHover" StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Color="#8B4DF7" Offset="0" />
            <GradientStop Color="#F25BA8" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="AccentPurple" Color="#A855F7" />
        <SolidColorBrush x:Key="AccentCyan" Color="#22D3EE" />
        <SolidColorBrush x:Key="CardBg" Color="#15151F" />
        <SolidColorBrush x:Key="CardBgHover" Color="#1D1D2C" />
        <SolidColorBrush x:Key="CardBorder" Color="#2A2A3A" />
        <SolidColorBrush x:Key="TextPrimary" Color="#ECECF2" />
        <SolidColorBrush x:Key="TextMuted" Color="#8E8EA0" />
        <SolidColorBrush x:Key="PanelBg" Color="#12121C" />
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- 기본 텍스트 색 -->
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>

        <!-- ▶ Play (primary, 그라데이션) -->
        <Style Selector="Button.play">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="0,14" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.play /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style Selector="Button.play:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentBrushHover}" />
            <Setter Property="TextElement.Foreground" Value="White" />
        </Style>
        <Style Selector="Button.play:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        </Style>

        <!-- ▷ Ghost (보조: 취소/뒤로) -->
        <Style Selector="Button.ghost">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.ghost /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1C1C2A" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource TextPrimary}" />
        </Style>

        <!-- ▢ 모드 선택 카드 -->
        <Style Selector="Button.card">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="20,18" />
        </Style>
        <Style Selector="Button.card /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource CardBg}" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>
        <Style Selector="Button.card:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource AccentPurple}" />
        </Style>
        <Style Selector="Button.card:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource CardBgHover}" />
        </Style>

        <!-- 입력/체크 -->
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <!-- 진행 바 accent -->
        <Style Selector="ProgressBar">
            <Setter Property="Foreground" Value="{StaticResource AccentPurple}" />
            <Setter Property="MinHeight" Value="6" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>

        <!-- 상태 칩 (Minecraft 26.1.2 / Fabric / 77 Mods / 자동 업데이트) -->
        <Style Selector="Border.chip">
            <Setter Property="Background" Value="{StaticResource PanelBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="11,5" />
        </Style>
        <Style Selector="Border.chip > TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        </Style>

        <!-- 커스텀 크롬 버튼 (최소화/닫기) -->
        <Style Selector="Button.chrome">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.chrome /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="7" />
        </Style>
        <Style Selector="Button.chrome:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#26FFFFFF" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource TextPrimary}" />
        </Style>
        <Style Selector="Button.chrome.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E81123" />
            <Setter Property="TextElement.Foreground" Value="White" />
        </Style>

        <!-- 푸터 내비 버튼 (디스코드/가이드/웹사이트/설정/로그) -->
        <Style Selector="Button.foot">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.foot /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.foot:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1C1C2A" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource TextPrimary}" />
        </Style>
    </Application.Styles>
</Application>
