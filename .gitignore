launcher/**/obj/

# ── Velopack / 빌드 산출물 ──
Releases/
publish/
*.nupkg

# ── packwiz 모드팩: 메타데이터(.pw.toml/pack.toml/index.toml)는 커밋, 캐시/다운로드는 무시 ──
.packwiz-cache/
modpack/.index-cache/

# ── 서버 런타임 데이터(설정 스크립트는 커밋, 실행 산출물은 무시) ──
server/world/
server/world_nether/
server/world_the_end/
server/logs/
server/crash-reports/
server/cache/
server/config/
server/mods/
server/libraries/
server/versions/
server/*.jar
server/eula.txt
server/usercache.json
server/whitelist.json
server/ops.json
server/banned-*.json
server/.fabric/

# ── 번역 작업: 소스(_work)·도구·결과(herma-ko)는 커밋, jar 캐시만 무시 ──
translations/_jars/

# ── 기타 ──
.DS_Store
Thumbs.db
*.log
/tmp/
launcher/tools/_*.png

# 번역 배치 스캐폴딩(일회성)
